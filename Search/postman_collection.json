              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('More results with larger radius', function () {",
              "    let jsonData = pm.response.json();",
              "    pm.expect(jsonData.results.length).to.be.greaterThan(2);",
              "});"
            ]
          }
        }
