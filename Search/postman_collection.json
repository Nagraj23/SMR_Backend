  "item": [
    {
      "name": "1️⃣ Nearby Pickup Search - Small Radius (1 km)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has matches_found property', function () {",
              "    let jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('matches_found');",
              "});",
              "",
              "pm.test('Response has results array', function () {",
              "    let jsonData = pm.response.json();",
              "    pm.expect(jsonData.results).to.be.an('array');",
              "});",
              "",
              "pm.test('Results sorted by distance', function () {",
              "    let jsonData = pm.response.json();",
              "    let results = jsonData.results;",
              "    for (let i = 1; i < results.length; i++) {",
              "        pm.expect(results[i].pickup_distance_km).to.be.at.least(results[i-1].pickup_distance_km);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lat\": 18.6750,\n  \"lon\": 75.9050,\n  \"radius_km\": 1.0\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/rides/nearby-pickup",
          "protocol": "http",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "rides",
            "nearby-pickup"
          ]
        },
        "description": "Search for nearby rides by passenger pickup location.\n\n**Mock Scenario**: Passenger at Indore city center (18.6750°N, 75.9050°E) searching for rides within 1 km.\n\n**Expected Behavior**: Should find RIDE001 and RIDE002 within 1 km radius."
      }
    },
    {
      "name": "2️⃣ Nearby Pickup Search - Large Radius (25 km)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
