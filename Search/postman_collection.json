{
  "info": {
    "name": "Ride Search API - Complete Test Suite",
    "description": "Comprehensive testing suite for Secure Polyglot Search Engine Cluster with mock data",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
