    {
      "name": "5️⃣ Exact Route Match - Both Source & Destination",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains pickup_distance and dropoff_distance', function () {",
              "    let jsonData = pm.response.json();",
              "    if (jsonData.results.length > 0) {",
              "        let firstResult = jsonData.results[0];",
              "        pm.expect(firstResult).to.have.property('pickup_distance_km');",
              "        pm.expect(firstResult).to.have.property('dropoff_distance_km');",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source_lat\": 18.6750,\n  \"source_lon\": 75.9050,\n  \"dest_lat\": 19.0760,\n  \"dest_lon\": 72.8777,\n  \"pickup_radius\": 1.0,\n  \"dropoff_radius\": 2.0\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/rides/search-exact",
          "protocol": "http",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "rides",
            "search-exact"
          ]
        },
        "description": "Find rides matching BOTH pickup and destination criteria.\n\n**Mock Scenario**: Passenger at Indore (18.6750°N, 75.9050°E) wants to reach Mumbai (19.0760°N, 72.8777°E).\n\n**Expected Behavior**: Should find RIDE001 and RIDE003 that match both pickup (within 1 km) and dropoff (within 2 km) criteria."
      }
    },
