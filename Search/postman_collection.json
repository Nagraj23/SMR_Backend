            "{{base_url}}"
          ],
          "path": [
            "api",
            "rides",
            "nearby-pickup"
          ]
        },
        "description": "Search with a larger radius to find more rides.\n\n**Mock Scenario**: Same location but with 25 km search radius.\n\n**Expected Behavior**: Should find RIDE001, RIDE002, RIDE003, and RIDE005."
      }
    },
    {
      "name": "3️⃣ Nearby Destination Search - 2 km Radius",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Results sorted by dropoff distance', function () {",
              "    let jsonData = pm.response.json();",
              "    let results = jsonData.results;",
              "    for (let i = 1; i < results.length; i++) {",
              "        pm.expect(results[i].dropoff_distance_km).to.be.at.least(results[i-1].dropoff_distance_km);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
