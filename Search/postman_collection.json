        "body": {
          "mode": "raw",
          "raw": "{\n  \"dest_lat\": 19.0760,\n  \"dest_lon\": 72.8777,\n  \"radius_km\": 2.0\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/rides/nearby-destination",
          "protocol": "http",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "rides",
            "nearby-destination"
          ]
